# test/agentic/shared/Containerfile
# Agentic test container with OpenSpec and OpenCode

FROM node:20-slim

# Install dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Create user matching host UID/GID
ARG USER_ID=1000
ARG GROUP_ID=1000
RUN groupadd -g ${GROUP_ID} opentest && \
    useradd -u ${USER_ID} -g opentest -m -s /bin/bash opentest

# Install OpenCode globally
RUN npm install -g opencode

# Copy and install OpenSpec from source
COPY --chown=opentest:opentest . /opt/openspec-src
WORKDIR /opt/openspec-src
RUN npm ci && npm run build && npm link

# Create OpenCode config directories
RUN mkdir -p /home/opentest/.config/opencode \
    && mkdir -p /home/opentest/.local/share/opencode \
    && chown -R opentest:opentest /home/opentest

# Create workspace directory (where tests run)
RUN mkdir -p /app/workspace \
    && chown -R opentest:opentest /app

# Create entrypoint that generates auth.json from env
RUN cat > /entrypoint.sh << 'EOF' && chmod +x /entrypoint.sh
#!/bin/bash
set -e
MODEL="${OPENCODE_MODEL:-zhipuai-coding-plan}"
if [ -n "$OPENCODE_API_KEY" ]; then
  mkdir -p /home/opentest/.local/share/opencode
  jq -n --arg model "$MODEL" --arg key "$OPENCODE_API_KEY" \
    '{($model): {type: "api", key: $key}}' \
    > /home/opentest/.local/share/opencode/auth.json
fi
exec "$@"
EOF

USER opentest
WORKDIR /app

ENTRYPOINT ["/entrypoint.sh"]
CMD ["opencode", "--help"]